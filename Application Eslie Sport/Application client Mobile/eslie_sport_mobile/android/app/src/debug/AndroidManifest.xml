<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Autorise le HTTP en clair, uniquement en debug, uniquement vers l'hote
         de l'emulateur Android (10.0.2.2) et localhost. C'est le seul moyen
         d'atteindre l'API Docker locale exposee sur http://localhost:8010
         depuis l'app. Le build release reste strictement HTTPS. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"/>
</manifest>
