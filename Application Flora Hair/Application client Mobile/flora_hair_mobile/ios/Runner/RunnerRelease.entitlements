<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build Release (TestFlight, App Store). Une archive envoyée avec
	     « development » est acceptée, mais aucune notification n'arrive.
	     La capacité « Push Notifications » doit être cochée sur l'App ID
	     com.florahair.floraHairMobile (developer.apple.com), et le profil
	     App Store créé APRÈS. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
