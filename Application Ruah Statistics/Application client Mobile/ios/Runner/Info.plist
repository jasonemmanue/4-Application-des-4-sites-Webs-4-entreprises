<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Ruah Statistics</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ruah Statistics</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- L'app est verrouillée en portrait (SystemChrome dans main.dart) : même
	     contrainte ici, pour que l'écran de lancement ne pivote pas. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad plein écran : sans cette clé, App Store Connect refuse un binaire
	     iPad qui n'accepte pas les 4 orientations (ITMS-90474). -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- Aucune autorisation (caméra, photos, micro, position) : l'app n'en
	     utilise aucune. En déclarer une sans s'en servir est un motif de rejet. -->

	<!-- Push (sujet FCM « actualites ») : réveil de l'app pour ranger le
	     message dans la boîte de notifications. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- url_launcher : canLaunchUrl() renvoie false pour tout schéma absent
	     d'ici. WhatsApp, appel et e-mail du cabinet échoueraient sans message. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
		<string>tel</string>
		<string>mailto</string>
		<string>whatsapp</string>
	</array>

	<!-- L'API de production est en HTTPS : aucune exception globale. Seul le
	     backend local (Docker) est autorisé pendant le développement. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Aucun chiffrement propriétaire : évite le questionnaire de conformité
	     export (« Missing Compliance ») à chaque envoi TestFlight. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
